# External PostgreSQL; use a dedicated development database, never a shared production database for tests.
DATABASE_URL=

# Configurable SMTP; unset means email delivery is unavailable, and verification is never bypassed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Must be a trusted public HTTPS origin in Preview/production; localhost is permitted for local development only.
APP_BASE_URL=http://localhost:3000

# Preview is public HTTPS; Secure is the default. Disable only for plain-HTTP local testing.
COOKIE_SECURE=true
TRUST_PROXY=1

# Important production gate; defaults OFF and all live-money endpoints reject when false.
REAL_MONEY_ENABLED=false
# Courtney Tech payouts also require the API key's payouts:create permission and this explicit operator gate.
COURTNEY_PAYOUTS_ENABLED=false

# User-selected Courtney Tech API. Keep credentials server-side in a secret manager.
B2CCOURTNEY_API_KEY=
B2CCOURTNEY_API_SECRET=

# No real payment occurs in the default mode.
PAYMENT_MODE=simulation
PORT=3000
LOG_LEVEL=info
